# =============================================================================
# Pocketbook — environment variable template
# Copy to .env and fill in all values before running docker compose up.
# Generate secrets with: openssl rand -base64 32  /  openssl rand -hex 32
# =============================================================================

# --- Postgres ---
PB_POSTGRES_USER=pocketbook
PB_POSTGRES_DB=pocketbook
# Strong password — change before first deploy
PB_POSTGRES_PASSWORD=changeme

# --- Auth (Auth.js v5) ---
# Full public URL of your Pocketbook instance
PB_NEXTAUTH_URL=https://pocketbook.yourdomain.com
# 32-char random secret: openssl rand -base64 32
PB_NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# --- App / Seed ---
# Display name shown in the sidebar header and login page
PB_USER_DISPLAY_NAME=Tida
# Credentials for the single seeded user (used by prisma db seed)
PB_SEED_USER_EMAIL=you@yourdomain.com
PB_SEED_USER_PASSWORD=changeme-on-first-boot

# --- Ollama ---
# Base URL of your Ollama instance (must be reachable from core_net)
PB_OLLAMA_BASE_URL=http://ollama:11434

# --- FX sync ---
# Shared secret for the /api/fx/sync endpoint: openssl rand -hex 32
PB_FX_SYNC_SECRET=replace-with-openssl-rand-hex-32

# --- Docker volumes ---
# Host base path for bind-mount volumes, e.g. /opt/docker
PB_DOCKER_DIR=/opt/docker

# --- Local dev ---
# Copy this file to .env and use localhost values for local development:
#   PB_NEXTAUTH_URL=http://localhost:3000
#   PB_DATABASE_URL=postgresql://pocketbook:<password>@localhost:5432/pocketbook
#   PB_OLLAMA_BASE_URL=http://localhost:11434
PB_DATABASE_URL=replace-with-local-postgres-url

# --- Auth.js host trust (required for custom hostnames like pocketbook.home) ---
AUTH_TRUST_HOST=true
