# =============================================================================
# Pocketbook — environment variable template
# Copy to .env and fill in all values before running docker compose up.
# Generate secrets with: openssl rand -base64 32  /  openssl rand -hex 32
# =============================================================================

# --- Postgres ---
PB_POSTGRES_USER=pocketbook
PB_POSTGRES_DB=pocketbook
# Strong password — change before first deploy
PB_POSTGRES_PASSWORD=changeme

# --- Auth (Auth.js v5) ---
# Full public URL of your Pocketbook instance (mapped to AUTH_URL inside the container)
PB_AUTH_URL=https://pocketbook.yourdomain.com
# 32-char random secret: openssl rand -base64 32  (mapped to AUTH_SECRET)
PB_AUTH_SECRET=replace-with-openssl-rand-base64-32

# --- App / Seed ---
# Display name shown in the sidebar header and login page
PB_USER_DISPLAY_NAME=Tida
# Optional: label shown in the login footer to distinguish deployments (e.g. "home", "work")
PB_INSTANCE_NAME=
# Credentials for the single seeded user (used by prisma db seed)
PB_SEED_USER_EMAIL=you@yourdomain.com
PB_SEED_USER_PASSWORD=changeme-on-first-boot

# --- Ollama ---
# Base URL of your Ollama instance (must be reachable from core_net)
PB_OLLAMA_BASE_URL=http://ollama:11434

# --- Logging (optional) ---
# Application logs go to stdout, so `docker logs pocketbook-web` shows requests,
# mutations, scheduled jobs, model generations, and errors.
# PB_LOG_LEVEL=info      # debug | info | warn | error | silent (default: info)
# PB_LOG_FORMAT=pretty   # pretty | json (default: pretty)
# PB_LOG_REQUESTS=1      # 0 to stop logging one line per request
# PB_LOG_COLOR=0         # 1 to colourise the level column

# --- Docker volumes ---
# Host base path for bind-mount volumes, e.g. /opt/docker
PB_DOCKER_DIR=/opt/docker

# --- Local dev only ---
# In Docker, DATABASE_URL is built from PB_POSTGRES_* vars inside entrypoint.sh.
# This is only needed for local `next dev` where entrypoint.sh is not used.
#   PB_AUTH_URL=http://localhost:3000
#   PB_OLLAMA_BASE_URL=http://localhost:11434
PB_DATABASE_URL=postgresql://pocketbook:<password>@localhost:5432/pocketbook

# --- Auth.js host trust (required for custom hostnames like pocketbook.home) ---
AUTH_TRUST_HOST=true
