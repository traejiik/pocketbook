# =============================================================================
# Pocketbook — host-side secrets file
#
# Copy this file to /opt/docker/pocketbook/stack.env on your Docker host
# and fill in every value before deploying.
#
# This file is read directly by Docker on every container start — including
# Watchtower-triggered restarts — so secrets are never lost across updates.
# Portainer's "Stack environment variables" panel is no longer needed.
#
# Generate secrets:
#   openssl rand -base64 32   →  use for AUTH_SECRET
#   openssl rand -hex 32      →  use for FX_SYNC_SECRET, PB_POSTGRES_PASSWORD
# =============================================================================

# --- Postgres password ---
# Must match in both entries below (one for the DB container, one for the app).
POSTGRES_PASSWORD=changeme
PB_POSTGRES_PASSWORD=changeme

# --- Auth.js ---
AUTH_URL=https://pocketbook.yourdomain.com
AUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Seed user (first-boot only; safe to re-run, idempotent) ---
SEED_USER_EMAIL=you@yourdomain.com
SEED_USER_PASSWORD=changeme-strong-password

# --- FX rate sync ---
FX_SYNC_SECRET=replace-with-openssl-rand-hex-32

# --- Display ---
PB_USER_DISPLAY_NAME=Pocketbook
# Optional label shown in login footer to distinguish deployments (e.g. "home", "work")
PB_INSTANCE_NAME=

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
