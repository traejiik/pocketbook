# =============================================================================
# Pocketbook — Portainer stack environment variables
#
# These are the variables to set in Portainer:
#   Stack → Environment variables → Advanced mode → paste these lines, then
#   fill in every value before deploying.
#
# Portainer stores them and re-applies them on every (re)deploy and Watchtower
# recreate, so secrets survive restarts without a host-side file.
#
# Variable naming: every variable uses a PB_ prefix so it never collides with
# other stacks in a shared Portainer instance. The container maps them to the
# bare names it needs internally (PB_AUTH_URL → AUTH_URL,
# PB_POSTGRES_PASSWORD → POSTGRES_PASSWORD, etc.). Use the PB_ names EXACTLY —
# a bare AUTH_URL set in the panel is ignored.
#
# Generate secrets:
#   openssl rand -base64 32   →  use for PB_AUTH_SECRET
#   openssl rand -hex 32      →  use for PB_FX_SYNC_SECRET, PB_POSTGRES_PASSWORD
# =============================================================================

# --- Postgres ---
# Used by the app to build DATABASE_URL, and mapped to the postgres image's
# bare POSTGRES_PASSWORD at startup. Only this PB_-prefixed name is needed.
PB_POSTGRES_PASSWORD=changeme

# --- Auth.js ---
PB_AUTH_URL=https://pocketbook.yourdomain.com
PB_AUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Seed user (first-boot only; safe to re-run, idempotent) ---
PB_SEED_USER_EMAIL=you@yourdomain.com
PB_SEED_USER_PASSWORD=changeme-strong-password

# --- FX rate sync and monthly insights (shared secret) ---
PB_FX_SYNC_SECRET=replace-with-openssl-rand-hex-32

# --- Display ---
PB_USER_DISPLAY_NAME=Pocketbook
# Optional label shown in login footer to distinguish deployments (e.g. "home", "work")
PB_INSTANCE_NAME=

# --- Ollama ---
PB_OLLAMA_BASE_URL=http://ollama:11434

# --- Optional: startup failure alert ---
# If set, the container POSTs a short text message here when startup fails
# (e.g. an ntfy topic: https://ntfy.sh/your-private-topic). Leave blank to disable.
# A failure report is always written to /data/startup-failures.log regardless.
# PB_ALERT_WEBHOOK=

# --- Optional: host base path for bind-mount volumes (defaults to /opt/docker) ---
# PB_DOCKER_DIR=/opt/docker
