# =============================================================================
# Pocketbook — host-side secrets file
#
# Copy this file to /opt/docker/pocketbook/stack.env on your Docker host
# and fill in every value before deploying.
#
# This file is read directly by Docker on every container start — including
# Watchtower-triggered restarts — so secrets are never lost across updates.
#
# Variable naming: all overridable variables use a PB_ prefix so they don't
# collide with other stacks in a shared Portainer instance. Docker Compose maps
# PB_AUTH_URL → AUTH_URL, PB_FX_SYNC_SECRET → FX_SYNC_SECRET, etc.
#
# Generate secrets:
#   openssl rand -base64 32   →  use for PB_AUTH_SECRET
#   openssl rand -hex 32      →  use for PB_FX_SYNC_SECRET, PB_POSTGRES_PASSWORD
# =============================================================================

# --- Postgres ---
PB_POSTGRES_PASSWORD=changeme

# --- Auth.js ---
PB_AUTH_URL=https://pocketbook.yourdomain.com
PB_AUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Seed user (first-boot only; safe to re-run, idempotent) ---
PB_SEED_USER_EMAIL=you@yourdomain.com
PB_SEED_USER_PASSWORD=changeme-strong-password

# --- FX rate sync and monthly insights (shared secret) ---
PB_FX_SYNC_SECRET=replace-with-openssl-rand-hex-32

# --- Display ---
PB_USER_DISPLAY_NAME=Pocketbook
# Optional label shown in login footer to distinguish deployments (e.g. "home", "work")
PB_INSTANCE_NAME=

# --- Ollama ---
PB_OLLAMA_BASE_URL=http://ollama:11434
