generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum CategoryKind {
  INCOME
  EXPENSE
  SAVINGS
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVINGS
}

enum RecurringCycle {
  MONTHLY
  ANNUAL
}

enum FxMode {
  AUTO
  MANUAL
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  insights     AiInsight[]
}

model Category {
  id               String          @id @default(cuid())
  name             String
  color            String
  kind             CategoryKind
  // Whether this category's transactions count toward the running balance and
  // month carry-over. The balance is derived on read, so flipping it re-computes
  // every past month; net, KPIs and charts ignore it.
  includeInBalance Boolean         @default(true)
  transactions     Transaction[]
  recurringRules   RecurringRule[]

  @@unique([name, kind])
}

model Transaction {
  id              String          @id @default(cuid())
  date            DateTime        @db.Date
  description     String
  amount          Decimal         @db.Decimal(14, 2)
  currency        String          @db.Char(3)
  // FX rate locked at write time: `currency` → `fxAnchor` multiplier on the day
  // the transaction was logged. Reads use this frozen value so historical totals
  // don't drift as live rates move. Null on legacy rows / when no FX path existed
  // at lock time → reads fall back to a live conversion. Recurring rules stay live.
  fxRate          Decimal?        @db.Decimal(14, 6)
  fxAnchor        String?         @db.Char(3)
  type            TransactionType
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  recurringRuleId String?
  recurringRule   RecurringRule?  @relation(fields: [recurringRuleId], references: [id])
  createdAt       DateTime        @default(now())

  @@unique([recurringRuleId, date])
  @@index([date])
  @@index([categoryId])
  @@index([type])
}

model RecurringRule {
  id                String         @id @default(cuid())
  name              String
  amount            Decimal        @db.Decimal(14, 2)
  currency          String         @db.Char(3)
  cycle             RecurringCycle
  nextDue           DateTime       @db.Date
  kind              CategoryKind
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id])
  installmentTotal  Int?
  installmentPaid   Int?
  installmentEndsOn DateTime?      @db.Date
  archived          Boolean        @default(false)
  transactions      Transaction[]

  // `getUpcomingRenewals` and `getRecurringRules` both filter on `archived` and
  // then range/sort on `nextDue`. Equality column first lets Postgres seek to the
  // `archived = false` prefix and read `nextDue` already ordered.
  @@index([archived, nextDue])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String   @db.Char(3)
  toCurrency   String   @db.Char(3)
  rate         Decimal  @db.Decimal(14, 6)
  mode         FxMode
  provider     String?
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([fromCurrency, toCurrency])
}

model AppSettings {
  id                     String  @id @default("singleton")
  anchorCurrency         String  @default("HUF") @db.Char(3)
  ollamaUrl              String  @default("http://ollama:11434")
  ollamaModel            String  @default("llama3.1:8b")
  fxAutoSync             Boolean @default(true)
  autoInsightsMonthly    Boolean @default(true)
  // One-time starting point for the derived running balance: the balance held on
  // the first day of `openingBalanceMonth` (`YYYY-MM`). Transactions before that
  // month are excluded from carry-over because this figure already includes them.
  // `openingBalanceMonth` null = not configured; carry-over then starts from zero.
  openingBalance         Decimal @default(0) @db.Decimal(14, 2)
  openingBalanceCurrency String  @default("HUF") @db.Char(3)
  openingBalanceMonth    String?
}

model AiInsight {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  monthCovered String
  modelUsed    String
  content      String   @db.Text
  generatedAt  DateTime @default(now())
  feedback     String?

  @@index([monthCovered])
}
